<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Tema Gokil — Omah Aksara</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    :root {
      --bg-color: #0a0a0a;
      --text-color: #f0f0f0;
      --accent: #ff00ff;
      --accent2: #00ffff;
    }
    body {
      background: var(--bg-color);
      color: var(--text-color);
      font-family: 'Montserrat', sans-serif;
      overflow-x: hidden;
    }
    .neon-text {
      color: var(--accent);
      text-shadow: 0 0 5px var(--accent), 0 0 10px var(--accent), 0 0 20px var(--accent);
    }
    .glow-btn {
      background: var(--accent);
      color: #fff;
      padding: 12px 24px;
      border-radius: 30px;
      text-transform: uppercase;
      font-size: 12px;
      letter-spacing: 0.2em;
      box-shadow: 0 0 10px var(--accent), 0 0 20px var(--accent);
      transition: all 0.3s ease;
    }
    .glow-btn:hover {
      background: var(--accent2);
      box-shadow: 0 0 10px var(--accent2), 0 0 20px var(--accent2);
    }
    .parallax {
      background-attachment: fixed;
      background-size: cover;
      background-position: center;
    }
  </style>
</head>
<body>

<!-- COVER -->
<section id="cover" class="h-screen flex flex-col justify-center items-center text-center parallax" style="background-image:url('cover.jpg')">
  <h2 id="cover-guest" class="neon-text text-2xl mb-4"></h2>
  <h1 id="cover-names" class="neon-text text-5xl font-bold mb-6"></h1>
  <p id="cover-date-string" class="text-gray-300 italic mb-8"></p>
  <button id="open-btn" class="glow-btn">Buka Undangan</button>
</section>

<!-- HERO -->
<section id="hero" class="min-h-screen flex flex-col justify-center items-center text-center bg-black">
  <h2 id="hero-names" class="text-4xl neon-text mb-8"></h2>
  <img id="hero-image" class="w-64 h-64 object-cover rounded-xl shadow-lg border-4 border-[var(--accent)]" src="">
</section>

<!-- QUOTE -->
<section id="quote" class="py-24 text-center bg-gray-900">
  <p id="quote-arab" class="text-3xl neon-text mb-6"></p>
  <p id="quote-text" class="italic text-lg text-gray-300 mb-4"></p>
  <p id="quote-source" class="text-sm text-gray-400"></p>
</section>

<!-- COUPLE -->
<section id="couple" class="py-24 grid grid-cols-1 md:grid-cols-2 gap-12 px-8">
  <div id="groom-section" class="text-center"></div>
  <div id="bride-section" class="text-center"></div>
</section>

<!-- LOVE STORY -->
<section id="story-section" class="py-24 bg-black text-center">
  <h3 class="neon-text text-3xl mb-12">Love Story</h3>
  <div id="story-list" class="space-y-12"></div>
</section>

<!-- EVENTS -->
<section id="event-section" class="py-24 bg-gray-900 text-center">
  <h3 class="neon-text text-3xl mb-12">Agenda Acara</h3>
  <div id="event-list" class="space-y-8"></div>
  <div id="countdown-wrap" class="mt-12 hidden">
    <h4 class="text-gray-300 mb-6">Countdown</h4>
    <div id="countdown" class="flex justify-center gap-6"></div>
  </div>
</section>

<!-- GALLERY -->
<section id="gallery-section" class="py-24 bg-black text-center">
  <h3 class="neon-text text-3xl mb-12">Galeri</h3>
  <div id="gallery-grid" class="grid grid-cols-2 md:grid-cols-3 gap-6 px-6"></div>
</section>

<!-- GIFT -->
<section id="gift-section" class="py-24 bg-gray-900 text-center">
  <h3 class="neon-text text-3xl mb-12">Wedding Gift</h3>
  <div id="gift-container" class="space-y-6"></div>
</section>

<!-- RSVP -->
<section id="rsvp-section" class="py-24 bg-black text-center">
  <h3 class="neon-text text-3xl mb-12">Doa & Restu</h3>
  <form id="wishes-form" class="space-y-6 max-w-md mx-auto">
    <input type="text" id="wish-name" placeholder="Nama Lengkap" class="w-full px-4 py-2 rounded-lg">
    <select id="wish-status" class="w-full px-4 py-2 rounded-lg">
      <option value="Hadir">Hadir</option>
      <option value="Tidak Hadir">Tidak Hadir</option>
    </select>
    <textarea id="wish-message" rows="4" placeholder="Ucapan / Doa" class="w-full px-4 py-2 rounded-lg"></textarea>
    <button type="submit" class="glow-btn w-full">Kirim Ucapan</button>
  </form>
  <div id="wishes-box" class="mt-12 space-y-4"></div>
</section>

<!-- FOOTER -->
<footer class="py-12 bg-gray-900 text-center">
  <h2 id="footer-names" class="neon-text text-2xl mb-4"></h2>
  <p class="text-gray-400 text-sm">Omah Aksara Digital Studio</p>
</footer>

<audio id="audio" loop></audio>

<script>
  const params = new URLSearchParams(window.location.search);
  const clientSlug = params.get('c') || 'budi-ani';
  const guestName = params.get('to')?.replace(/\+/g,' ') || 'Tamu Undangan';
  const basePath = `../../public/clients/${clientSlug}/`;

  fetch(`${basePath}data.json`, { cache: 'no-store' })
    .then(res => res.json())
    .then(data => {
      const { couple, events, gallery, loveStory, quote } = data;
      const pairNick = `${couple.groom.nickname} & ${couple.bride.nickname}`;

      document.getElementById('cover-names').innerText = pairNick;
      document.getElementById('hero-names').innerText = pairNick;
      document.getElementById('footer-names').innerText = pairNick;
      document.getElementById('cover-guest').innerText = guestName;
      document.getElementById('hero-image').src = basePath + gallery.heroImage;
      document.getElementById('cover-image').src = basePath + gallery.coverImage;

      if(events?.length){
        document.getElementById('event-section').classList.remove('hidden');
        document.getElementById('event-list').innerHTML = events.map(ev => `
          <div class="bg-black border border-gray-700 rounded-xl p-6 shadow-lg">
            <h5 class="neon-text text-xl mb-2">${ev.title}</h5>
            <p class="text-gray-300 text-sm">${new Date(ev.date).toLocaleDateString('id-ID',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}</p>
            <p class="text-gray-400 text-xs">${ev.startTime} — ${ev.endTime}</p>
            <p class="text-gray-400 text-xs italic">${ev.address}</p>
          </div>
        `).join('');
      }

      if(quote?.text){
        document.getElementById('quote-arab').textContent = quote.arab;
        document.getElementById('quote-text').textContent = quote.text;
        document.getElementById('quote-source').textContent = quote.source;
      }

      if(loveStory?.length){
        document.getElementById('story-section').classList.remove('hidden');
        document.getElementById('story-list').innerHTML = loveStory.map(ls => `
          <div class="bg-gray-
