<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Karsa — Omah Aksara</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Montserrat:wght@200;300;400;500;600&family=Great+Vibes&family=Scheherazade+New:wght@400;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/color-thief/2.3.2/color-thief.umd.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root {
            --theme-color: #2B4C8C;
            --bg-color: #FDFCF8;
            --text-color: #2C2C2C;
            --soft-color: #E8E2D5;
            --white-soft: #FFFFFF;
            --accent: #8FB5E8;
            --blue-dark: #1E3A6F;
            --blue-light: #D6E4F7;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        html { scroll-behavior: smooth; }
        body {
            background: var(--bg-color);
            color: var(--text-color);
            font-family: 'Montserrat', sans-serif;
            overflow-x: hidden;
            line-height: 1.8;
            -webkit-font-smoothing: antialiased;
        }
      .font-serif { font-family: 'Playfair Display', serif; }
      .font-script { font-family: 'Great Vibes', cursive; }
      .font-arab { font-family: 'Scheherazade New', serif; }
      .reveal { opacity: 0; transform: translateY(40px); transition: all 1.6s cubic-bezier(0.16, 1, 0.3, 1); }
      .reveal.active { opacity: 1; transform: translateY(0); }
      .line-draw { width: 0%; transition: width 2s cubic-bezier(0.16, 1, 0.3, 1); }
      .reveal.active.line-draw { width: 100%; }

       /* Torn Paper Effect */
      .torn-top {
            position: relative;
       }
      .torn-top::before {
            content: '';
            position: absolute;
            top: -1px;
            left: 0;
            right: 0;
            height: 40px;
            background: var(--blue-light);
            clip-path: polygon(0% 100%, 5% 85%, 12% 95%, 18% 80%, 25% 90%, 32% 75%, 40% 88%, 48% 78%, 55% 92%, 63% 82%, 70% 94%, 78% 79%, 85% 91%, 92% 84%, 100% 100%);
       }
      .torn-bottom::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            right: 0;
            height: 40px;
            background: var(--blue-light);
            clip-path: polygon(0% 0%, 8% 15%, 15% 5%, 22% 20%, 30% 8%, 38% 18%, 45% 6%, 53% 16%, 61% 4%, 69% 14%, 77% 2%, 85% 12%, 92% 6%, 100% 0%);
       }

       /* Daisy Decoration */
      .daisy-decoration {
            position: absolute;
            width: 60px;
            height: 60px;
            opacity: 0.4;
            pointer-events: none;
       }
      .daisy-decoration svg { width: 100%; height: 100%; }

       /* Initial Monogram */
      .initial-monogram {
            font-family: 'Playfair Display', serif;
            font-size: 120px;
            font-weight: 400;
            color: var(--theme-color);
            line-height: 1;
            opacity: 0.9;
       }

       /* Oval Program Box */
      .oval-program {
            border: 2px solid var(--theme-color);
            border-radius: 50%;
            padding: 40px 30px;
            width: 280px;
            margin: 0 auto;
            background: white;
       }

       /* Color Guide Dots */
      .color-dot {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: inline-block;
            margin: 0 4px;
            border: 2px solid white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
       }

        #cover { transition: transform 1.8s cubic-bezier(0.76, 0, 0.24, 1), opacity 1.8s; }
      .cover-gradient { background: linear-gradient(to top, rgba(43,76,140,0.8) 0%, rgba(43,76,140,0.3) 50%, rgba(0,0,0,0) 100%); }
      .btn-open {
            border: 1px solid rgba(255,255,255,0.3);
            background: rgba(255,255,255,0.1);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            padding: 18px 44px;
            letter-spacing: 5px;
            font-size: 9px;
            text-transform: uppercase;
            transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
      .btn-open:hover { background: #ffffff; color: var(--theme-color); border-color: #ffffff; letter-spacing: 7px; }
      .phone-wrapper {
            max-width: 425px;
            margin: 0 auto;
            background: var(--white-soft);
            box-shadow: 0 40px 100px rgba(0,0,0,0.04);
            position: relative;
            min-height: 100vh;
        }
      .editorial-frame {
            position: relative;
            width: 85%;
            aspect-ratio: 3/4;
            margin: 0 auto;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(43,76,140,0.15);
            border: 8px solid white;
            background: #f0ebe1;
        }
      .editorial-frame img { width: 100%; height: 100%; object-fit: cover; transition: transform 3s ease; }
      .editorial-frame:hover img { transform: scale(1.06); }
      .arch-mask { border-radius: 200px 200px 0 0; }

       /* Timeline jadi oval */
      .timeline-oval {
            border: 1.5px solid var(--theme-color);
            border-radius: 100px;
            padding: 30px 25px;
            background: white;
            position: relative;
       }

      .btn-editorial {
            display: inline-block;
            border: 1.5px solid var(--theme-color);
            color: var(--theme-color);
            padding: 14px 38px;
            font-size: 10px;
            letter-spacing: 4px;
            text-transform: uppercase;
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            background: transparent;
            border-radius: 0;
        }
      .btn-editorial:hover { background: var(--theme-color); color: #fff; letter-spacing: 5px; }

      .music-disk-box {
            position: fixed;
            bottom: 35px;
            right: calc(50% - 190px);
            z-index: 90;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: opacity 0.5s;
        }
        @media (max-width: 435px) {.music-disk-box { right: 25px; } }
      .disk-text-wrap {
            width: 52px;
            height: 52px;
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid var(--theme-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 25px rgba(43,76,140,0.15);
            animation: rotateDisk 8s linear infinite;
        }
      .disk-text-wrap.paused { animation-play-state: paused; }
        @keyframes rotateDisk { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

      .section-title-script {
            font-family: 'Great Vibes', cursive;
            font-size: 42px;
            color: var(--theme-color);
            font-weight: 400;
       }
    </style>
</head>
<body>
<!-- COVER -->
<section id="cover" class="fixed inset-0 z-[100] flex items-center justify-center overflow-hidden bg-[#1E3A6F]">
    <img id="cover-image" class="absolute inset-0 w-full h-full object-cover opacity-60 scale-105 transition-transform duration-1000" src="" crossorigin="anonymous">
    <div class="cover-gradient absolute inset-0"></div>
    <div class="relative z-10 text-center text-white px-8 max-w-sm">
        <p class="uppercase tracking-[0.5em] text-xs mb-4 opacity-80">THE WEDDING OF</p>
        <h1 id="cover-names" class="font-serif text-5xl font-light mb-3 tracking-wider leading-tight"></h1>
        <div class="initial-monogram mb-8" id="cover-initials"></div>
        <div class="h-px w-20 bg-white/30 mx-auto mb-6"></div>
        <div class="border border-white/40 px-6 py-2 inline-block mb-10">
            <p id="cover-date" class="font-serif text-2xl tracking-widest"></p>
        </div>
        <p class="uppercase tracking-[0.4em] text-xs mb-2.5 text-white/70 font-medium">Salam Hangat Untuk:</p>
        <h2 id="cover-guest" class="font-serif text-2xl font-light tracking-wide text-white mb-14"></h2>
        <button id="open-btn" class="btn-open">Buka Undangan</button>
    </div>
</section>

<!-- MAIN APP -->
<main id="app" class="phone-wrapper opacity-0 pb-1">
    <!-- HERO -->
    <section class="relative h-[600px] flex items-end justify-center px-6 pb-20 overflow-hidden">
        <img id="hero-image" class="absolute inset-0 w-full h-full object-cover" src="">
        <div class="absolute inset-0 bg-gradient-to-t from-white via-white/40 to-transparent"></div>
        <div class="relative z-10 text-center w-full">
            <div class="initial-monogram text-[80px] mb-2" id="hero-initials"></div>
            <h2 id="hero-names" class="font-serif text-4xl font-light tracking-widest text-[var(--theme-color)]"></h2>
        </div>
    </section>

    <!-- QUOTE -->
    <section class="px-10 py-20 text-center reveal torn-top torn-bottom bg-[var(--blue-light)]">
        <p id="quote-arab" class="font-arab text-2xl mb-6 text-[var(--theme-color)] leading-loose"></p>
        <p id="quote-text" class="font-serif italic text-base text-[var(--blue-dark)] font-light leading-relaxed"></p>
        <div class="h-px w-12 bg-[var(--theme-color)]/40 mx-auto mt-6 mb-3 line-draw"></div>
        <p id="quote-source" class="text-xs uppercase tracking-[0.35em] font-medium text-[var(--theme-color)]/70"></p>
    </section>

    <!-- THE WEDDING PROGRAM -->
    <section id="event-section" class="py-20 px-8 bg-white hidden">
        <div class="text-center mb-12 reveal">
            <p class="font-script text-3xl text-[var(--theme-color)] mb-2">The Wedding Program</p>
            <div class="oval-program">
                <div class="initial-monogram text-[60px] mb-4" id="program-initials"></div>
                <div id="event-list" class="space-y-3 text-sm"></div>
            </div>
        </div>

        <!-- COUNTDOWN -->
        <div id="countdown-wrap" class="mt-16 text-center hidden">
            <p class="uppercase tracking-[0.3em] text-xs font-medium mb-6 text-[var(--theme-color)]">Menuju Hari Bahagia</p>
            <div id="countdown" class="flex justify-center gap-4"></div>
        </div>
    </section>

    <!-- OUR LOVE STORY -->
    <section id="story-section" class="py-20 px-8 bg-[#FDFCF8] torn-top torn-bottom hidden">
        <div class="text-center mb-12 reveal">
            <h3 class="section-title-script mb-8">Our Love Story</h3>
        </div>
        <div id="story-list" class="space-y-8 max-w-sm mx-auto"></div>
    </section>

    <!-- THE DETAILS -->
    <section class="py-20 px-8 bg-white">
        <div class="text-center mb-12 reveal">
            <h3 class="section-title-script mb-8">The Details</h3>
        </div>

        <!-- Dress Code -->
        <div class="text-center mb-12 reveal">
            <p class="text-xs uppercase tracking-[0.4em] text-[var(--theme-color)] mb-4">Dress Code</p>
            <div class="flex justify-center gap-8 mb-6">
                <div class="text-center">
                    <i class="fa-solid fa-person-dress text-4xl text-[var(--theme-color)] mb-2"></i>
                    <p class="text-xs text-stone-600">Formal Attire</p>
                </div>
                <div class="text-center">
                    <i class="fa-solid fa-user-tie text-4xl text-[var(--theme-color)] mb-2"></i>
                    <p class="text-xs text-stone-600">Formal Attire</p>
                </div>
            </div>
        </div>

        <!-- Color Guide -->
        <div class="text-center mb-12 reveal">
            <p class="text-xs uppercase tracking-[0.4em] text-[var(--theme-color)] mb-4">Color Guide</p>
            <div class="flex justify-center">
                <span class="color-dot" style="background: #1E3A6F;"></span>
                <span class="color-dot" style="background: #2B4C8C;"></span>
                <span class="color-dot" style="background: #8FB5E8;"></span>
                <span class="color-dot" style="background: #D6E4F7;"></span>
            </div>
            <p class="text-xs text-stone-500 mt-3 italic">Blue Palette</p>
        </div>
    </section>

    <!-- THE VENUES -->
    <section class="py-20 px-8 bg-[var(--blue-light)] torn-top torn-bottom">
        <div class="text-center mb-12 reveal">
            <h3 class="section-title-script mb-8">The Venues</h3>
        </div>
        <div id="venues-list"></div>
    </section>

    <!-- GALLERY -->
    <section id="gallery-section" class="py-20 px-6 bg-white hidden">
        <div class="text-center mb-12 reveal">
            <h3 class="section-title-script mb-2">The Gallery</h3>
        </div>
        <div id="gallery-grid" class="grid grid-cols-3 gap-2"></div>
    </section>

    <!-- GIFT GUIDE + RSVP -->
    <section class="py-20 px-8 bg-[#FDFCF8]">
        <div class="text-center mb-12 reveal">
            <h3 class="section-title-script mb-8">R.S.V.P</h3>
        </div>

        <!-- Gift Guide -->
        <div id="gift-section" class="mb-16 hidden">
            <p class="text-xs uppercase tracking-[0.4em] text-[var(--theme-color)] mb-4 text-center">Gift Guide</p>
            <p class="text-xs text-stone-600 text-center mb-6 px-4 leading-relaxed italic">
                Kehadiran dan doa restu Anda adalah hadiah terindah. Namun jika berkenan memberi, kami menerima dengan penuh syukur.
            </p>
            <div id="gift-container" class="space-y-3 max-w-sm mx-auto"></div>
        </div>

        <!-- Snap and Share -->
        <div class="text-center mb-12 reveal">
            <p class="text-xs uppercase tracking-[0.4em] text-[var(--theme-color)] mb-3">Snap and Share</p>
            <p class="text-xs text-stone-600 mb-4 px-6 leading-relaxed">
                Bantu kami mengabadikan momen indah. Tag kami di Instagram
            </p>
            <div class="flex justify-center gap-4 text-[var(--theme-color)]">
                <i class="fa-brands fa-instagram text-2xl"></i>
                <i class="fa-brands fa-facebook text-2xl"></i>
            </div>
        </div>

        <!-- RSVP FORM -->
        <form id="wishes-form" class="space-y-4 bg-white p-6 border border-[var(--theme-color)]/20 mb-10 max-w-sm mx-auto">
            <div><label class="block text-xs uppercase tracking-[0.3em] mb-2 text-[var(--theme-color)]">Nama</label><input type="text" id="wish-name" required class="w-full bg-transparent border-b border-[var(--theme-color)]/30 py-2 text-sm focus:outline-none focus:border-[var(--theme-color)] transition"></div>
            <div class="grid grid-cols-2 gap-4">
                <div><label class="block text-xs uppercase tracking-[0.3em] mb-2 text-[var(--theme-color)]">Kehadiran</label><select id="wish-status" class="w-full bg-transparent border-b border-[var(--theme-color)]/30 py-2 text-sm focus:outline-none focus:border-[var(--theme-color)] transition"><option value="Hadir">Hadir</option><option value="Tidak Hadir">Tidak Hadir</option></select></div>
                <div><label class="block text-xs uppercase tracking-[0.3em] mb-2 text-[var(--theme-color)]">Jumlah</label><select id="wish-pax" class="w-full bg-transparent border-b border-[var(--theme-color)]/30 py-2 text-sm focus:outline-none focus:border-[var(--theme-color)] transition"><option value="1">1 Pax</option><option value="2">2 Pax</option><option value="3">3 Pax</option><option value="4">4 Pax</option></select></div>
            </div>
            <div><label class="block text-xs uppercase tracking-[0.3em] mb-2 text-[var(--theme-color)]">Pesan / Doa</label><textarea id="wish-message" required rows="3" class="w-full bg-transparent border border-[var(--theme-color)]/30 p-3 text-sm focus:outline-none focus:border-[var(--theme-color)] transition resize-none"></textarea></div>
            <button type="submit" class="w-full bg-[var(--theme-color)] text-white text-xs uppercase tracking-[0.4em] py-4 hover:bg-[var(--blue-dark)] transition duration-500">Kirim Ucapan</button>
        </form>
        <div class="border-t border-[var(--theme-color)]/20 pt-8 max-w-sm mx-auto">
            <p class="text-xs uppercase tracking-[0.3em] mb-6 text-center text-[var(--theme-color)]">Daftar Ucapan Tamu</p>
            <div id="wishes-box" class="space-y-3 max-h-96 overflow-y-auto pr-2"></div>
        </div>
    </section>

    <!-- GENTLE REMINDERS + QR -->
    <section class="py-16 px-8 bg-[var(--blue-light)] text-center torn-top">
        <p class="text-xs uppercase tracking-[0.4em] text-[var(--theme-color)] mb-4">Gentle Reminders</p>
        <div class="text-xs text-[var(--blue-dark)] space-y-2 mb-8 max-w-sm mx-auto">
            <p>• Mohon hadir tepat waktu</p>
            <p>• Dress code: Formal Attire</p>
            <p>• Dilarang membawa makanan dari luar</p>
        </div>
        <div class="w-32 h-32 mx-auto bg-white p-2 border-2 border-[var(--theme-color)] mb-6">
            <div class="w-full h-full bg-[var(--theme-color)]/10 flex items-center justify-center">
                <i class="fa-solid fa-qrcode text-5xl text-[var(--theme-color)]"></i>
            </div>
        </div>
        <p class="text-xs text-[var(--blue-dark)] italic">Scan untuk info lengkap</p>
    </section>

    <footer class="py-20 bg-[var(--blue-dark)] text-white text-center px-8">
        <p class="font-serif italic text-base text-white/70 mb-4">Terima Kasih,</p>
        <h2 id="footer-names" class="font-serif text-3xl font-light tracking-widest text-white mb-8"></h2>
        <div class="h-px w-8 bg-white/30 mx-auto mb-6"></div>
        <p class="text-xs uppercase tracking-[0.6em] text-white/50 font-mono">Designed by Omah Aksara</p>
    </footer>
</main>

<!-- MUSIC FLOATER -->
<div id="music-btn" class="music-disk-box hidden">
    <div id="disk-wrap" class="disk-text-wrap">
        <svg class="w-full h-full p-1 text-[var(--theme-color)] opacity-70" viewBox="0 0 100 100">
            <path id="textPath" d="M 50,50 m -37,0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" fill="none"></path>
            <text font-size="8.3" font-family="Playfair Display" letter-spacing="3" fill="currentColor"><textPath href="#textPath"> • SENANDUNG AKSARA • GENDING RAMPAK </textPath></text>
        </svg>
        <i id="music-icon-state" class="fa-solid fa-play absolute text-sm text-[var(--theme-color)]"></i>
    </div>
</div>
<audio id="audio" loop></audio>

<script>
    const params = new URLSearchParams(window.location.search);
    const clientSlug = params.get('c') || 'afif-sindi';
    const guestName = params.get('to')?.replace(/\+/g,' ') || 'Tamu Undangan';
    const basePath = `../../public/clients/${clientSlug}/`;
    const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwzbrMzVWSHCF9u8I1FbY4h4i_GoxL6kvTbFxFrcZ-VG9_qun2wK0c4mIupBKiGk1Yvmw/exec';

    fetch(`${basePath}data.json`, { cache: 'no-store' })
  .then(res => {
        if(!res.ok) throw new Error(`data.json tidak ditemukan`);
        return res.json();
    })
  .then(data => {
        const { couple, settings, events, gallery, loveStory, quote, logistics, music, digitalGift } = data;
        const pairNick = `${couple.groom.nickname} & ${couple.bride.nickname}`;
        const initials = `${couple.groom.nickname.charAt(0)} & ${couple.bride.nickname.charAt(0)}`;

        // Set colors
        if(settings?.themeColor) document.documentElement.style.setProperty('--theme-color', settings.themeColor);
        if(settings?.bgColor) document.documentElement.style.setProperty('--bg-color', settings.bgColor);

        // Names & Initials
        document.getElementById('cover-names').innerText = pairNick;
        document.getElementById('hero-names').innerText = pairNick;
        document.getElementById('footer-names').innerText = pairNick;
        document.getElementById('cover-initials').innerText = initials;
        document.getElementById('hero-initials').innerText = initials;
        document.getElementById('program-initials').innerText = initials;
        document.getElementById('cover-guest').innerText = guestName;

        // Date
        if(events?.length) {
            const eventDate = new Date(events[0].date);
            const dateStr = eventDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase();
            document.getElementById('cover-date').innerText = dateStr.replace(/,/g, '');
        }

        // Images
        document.getElementById('hero-image').src = basePath + gallery.heroImage;
        document.getElementById('cover-image').src = basePath + gallery.heroImage;
        document.getElementById('hero-image').onerror = function() { this.src = 'https://placehold.co/600x800/e2e8f0/64748b?text=Foto+Hero'; };
        document.getElementById('cover-image').onerror = function() { this.src = 'https://placehold.co/600x800/1e293b/94a3b8?text=Foto+Cover'; };

        // Quote
        if(quote?.text) {
            document.getElementById('quote-arab').textContent = quote.arab || '';
            document.getElementById('quote-text').innerHTML = `“ ${quote.text} ”`;
            document.getElementById('quote-source').textContent = quote.source || '';
        }

        // Events - Oval Program Style
        if(events?.length) {
            document.getElementById('event-section').classList.remove('hidden');
            document.getElementById('event-list').innerHTML = '';
            events.forEach(ev => {
                const timeStr = `${ev.startTime} ${ev.timezone || ''}`;
                document.getElementById('event-list').innerHTML += `
                    <div class="mb-2">
                        <p class="font-serif text-lg text-[var(--theme-color)]">${timeStr}</p>
                        <p class="text-xs uppercase tracking-wider text-stone-600">${ev.title}</p>
                    </div>`;
            });

            // Venues
            document.getElementById('venues-list').innerHTML = '';
            events.forEach(ev => {
                document.getElementById('venues-list').innerHTML += `
                    <div class="bg-white border-2 border-[var(--theme-color)]/20 p-6 text-center mb-6 max-w-sm mx-auto">
                        <h5 class="font-serif text-xl font-medium text-[var(--theme-color)] mb-2">${ev.title.toUpperCase()}</h5>
                        <p class="text-xs text-stone-600 mb-4 px-4">${ev.address}</p>
                        <a href="${ev.googleMaps}" target="_blank" class="btn-editorial text-xs">Buka Peta</a>
                    </div>`;
            });

            // Countdown
            if(settings.showCountdown) {
                const tzMap = { WITA: '+08:00', WIB: '+07:00', WIT: '+09:00' };
                const tz = tzMap[events[0].timezone] || '+08:00';
                const targetTime = new Date(`${events[0].date}T${events[0].startTime}:00${tz}`).getTime();
                setInterval(() => {
                    const now = new Date().getTime();
                    const diff = targetTime - now;
                    const d = Math.max(0, Math.floor(diff / (1000*60*60*24)));
                    const h = Math.max(0, Math.floor((diff % (1000*60*60*24)) / (1000*60*60)));
                    const m = Math.max(0, Math.floor((diff % (1000*60*60)) / (1000*60)));
                    const s = Math.max(0, Math.floor((diff % (1000*60)) / 1000));
                    document.getElementById('countdown').innerHTML = `
