<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
    <title>Karsa — Omah Aksara</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Montserrat:wght@200;300;400;500;600&family=Scheherazade+New:wght@400;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root { --theme-color: #1A1A1A; --bg-color: #FAFAFA; --text-color: #2D2D2D; --soft-color: #E5E5E5; }
        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        html { scroll-behavior: smooth; }
        body { background: #121212; color: var(--text-color); font-family: 'Montserrat', sans-serif; overflow-x: hidden; line-height: 1.7; }
        .font-serif { font-family: 'Cormorant Garamond', serif; }
        .font-arab { font-family: 'Scheherazade New', serif; }
        .reveal { opacity: 0; transform: translateY(20px); transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1); }
        .reveal.active { opacity: 1; transform: translateY(0); }
        #cover { transition: transform 1.2s cubic-bezier(0.76, 0, 0.24, 1), opacity 1.2s; }
        .phone-wrapper { max-width: 425px; margin: 0 auto; background: var(--bg-color); box-shadow: 0 0 60px rgba(0,0,0,0.4); min-height: 100vh; position: relative; }
        .modern-frame { width: 100%; aspect-ratio: 4/5; overflow: hidden; background: #F5F5F5; border: 1px solid var(--soft-color); }
        .modern-frame img { width: 100%; height: 100%; object-fit: cover; }
        .timeline-card { border-left: 2px solid var(--theme-color); padding-left: 20px; position: relative; }
        .timeline-card::before { content: ''; position: absolute; left: -6px; top: 6px; width: 10px; height: 10px; background: var(--theme-color); border-radius: 50%; }
        .btn-action { display: inline-flex; align-items: center; justify-content: center; gap: 8px; width: 100%; border: 1px solid var(--theme-color); color: #FFFFFF; background: var(--theme-color); padding: 12px 20px; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; transition: all 0.3s ease; }
        .btn-action.secondary { background: transparent; color: var(--theme-color); }
        .music-floating-btn { position: fixed; bottom: 30px; right: 25px; z-index: 90; cursor: pointer; }
        .music-circle { width: 44px; height: 44px; background: #FFFFFF; border: 1px solid var(--soft-color); border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 15px rgba(0,0,0,0.08); }
    </style>
</head>
<body>

<section id="cover" class="fixed inset-0 z-[100] flex items-center justify-center bg-[#121212]">
    <img id="cover-image" class="absolute inset-0 w-full h-full object-cover opacity-30" src="">
    <div class="relative z-10 text-center text-white px-8 w-full max-w-sm">
        <p class="uppercase tracking-[0.4em] text-[9px] mb-3 text-stone-400">Pernikahan Suci</p>
        <h1 id="cover-names" class="font-serif text-4xl font-light mb-12 tracking-wide"></h1>
        <p class="uppercase tracking-[0.3em] text-[9px] mb-2 text-stone-400">Kepada Yth. Bapak/Ibu/Saudara/i:</p>
        <h2 id="cover-guest" class="font-serif text-2xl font-light mb-14 text-stone-200"></h2>
        <button id="open-btn" class="border border-white/40 px-8 py-4 tracking-[0.3em] text-[9px] uppercase hover:bg-white hover:text-black transition-all">Buka Undangan</button>
    </div>
</section>

<main id="app" class="phone-wrapper opacity-0 pb-1">
    <section class="relative h-[100vh] flex items-end justify-center px-6 pb-28 bg-white">
        <img id="hero-image" class="absolute inset-0 w-full h-full object-cover opacity-95" src="">
        <div class="absolute inset-0 bg-gradient-to-t from-[#FAFAFA] via-transparent to-transparent"></div>
        <div class="relative z-10 text-center w-full reveal">
            <h2 id="hero-names" class="font-serif text-4xl font-light text-[var(--text-color)]"></h2>
        </div>
    </section>

    <section class="px-8 py-24 text-center bg-white border-b border-stone-100 reveal">
        <p id="quote-arab" class="font-arab text-2xl mb-6 text-neutral-700"></p>
        <p id="quote-text" class="font-serif italic text-base text-neutral-600"></p>
        <p id="quote-source" class="text-[9px] uppercase tracking-[0.3em] font-semibold text-stone-400 mt-6"></p>
    </section>

    <section class="py-24 px-6 bg-[#FAFAFA] space-y-20">
        <div id="groom-section" class="space-y-6"></div>
        <div class="py-2 text-center reveal"><span class="font-serif font-light text-2xl text-stone-300">— & —</span></div>
        <div id="bride-section" class="space-y-6"></div>
    </section>

    <section id="story-section" class="py-24 bg-white hidden"><div id="story-list" class="px-6 space-y-12"></div></section>
    <section id="event-section" class="py-24 px-6 bg-[#FAFAFA] hidden"><div id="event-list" class="space-y-10"></div><div id="countdown-wrap" class="mt-20 pt-16 border-t border-stone-200 hidden text-center"><div id="countdown" class="flex justify-center gap-3"></div></div></section>
    <section id="gallery-section" class="py-24 px-6 bg-white hidden"><div id="gallery-grid" class="grid grid-cols-2 gap-3"></div></section>
    <section id="gift-section" class="py-24 px-6 bg-[#FAFAFA] hidden"><div id="gift-container" class="space-y-4"></div></section>

    <section id="rsvp-section" class="py-24 px-6 bg-white border-t border-stone-100">
        <h3 class="font-serif text-3xl font-light mb-10 text-center">Konfirmasi Kehadiran</h3>
        <form id="wishes-form" class="space-y-4 bg-[#FAFAFA] p-6 border border-stone-200">
            <input type="text" id="wish-name" placeholder="Nama Lengkap" required class="w-full bg-transparent border-b border-stone-300 py-2 text-sm focus:outline-none">
            <select id="wish-status" class="w-full bg-transparent border-b border-stone-300 py-2 text-sm"><option value="Hadir">Hadir</option><option value="Tidak Hadir">Tidak Hadir</option></select>
            <textarea id="wish-message" required rows="3" placeholder="Pesan & Doa" class="w-full bg-transparent border border-stone-300 p-2 text-sm"></textarea>
            <button type="submit" class="w-full bg-black text-white text-[9px] uppercase tracking-[0.3em] py-4">Kirim Konfirmasi</button>
        </form>
        <div class="border-t border-stone-200 pt-8 mt-8"><div id="wishes-box" class="space-y-3 max-h-80 overflow-y-auto"></div></div>
    </section>

    <footer class="py-16 bg-[#1A1A1A] text-white text-center px-6">
        <h2 id="footer-names" class="font-serif text-2xl font-light tracking-widest mb-8"></h2>
        <p class="text-[9px] uppercase tracking-[0.5em] text-stone-500">Omah Aksara</p>
    </footer>
</main>

<div id="music-btn" class="music-floating-btn hidden"><div class="music-circle"><i id="music-icon" class="fa-solid fa-play text-xs"></i></div></div>
<audio id="audio" loop></audio>

<script>
    const params = new URLSearchParams(window.location.search);
    const clientSlug = params.get('c') || 'afif-sindi';
    const guestName = params.get('to')?.replace(/\+/g,' ') || 'Tamu Undangan';
    const basePath = `../../public/clients/${clientSlug}/`;
    const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwzbrMzVWSHCF9u8I1FbY4h4i_GoxL6kvTbFxFrcZ-VG9_qun2wK0c4mIupBKiGk1Yvmw/exec';

    fetch(`${basePath}data.json`, { cache: 'no-store' }).then(res => res.json()).then(data => {
        const { couple, settings, events, gallery, loveStory, quote, music, digitalGift } = data;
        const pairNick = `${couple.groom.nickname} & ${couple.bride.nickname}`;
        
        document.getElementById('cover-names').innerText = pairNick;
        document.getElementById('hero-names').innerText = pairNick;
        document.getElementById('footer-names').innerText = pairNick;
        document.getElementById('cover-guest').innerText = guestName;
        document.getElementById('hero-image').src = basePath + gallery.heroImage;
        document.getElementById('cover-image').src = basePath + gallery.heroImage;

        // Render sections logic...
        document.getElementById('groom-section').innerHTML = `<div class="modern-frame reveal"><img src="${basePath + couple.groom.image}"></div><h4 class="font-serif text-3xl font-light">${couple.groom.name}</h4>`;
        document.getElementById('bride-section').innerHTML = `<div class="modern-frame reveal"><img src="${basePath + couple.bride.image}"></div><h4 class="font-serif text-3xl font-light">${couple.bride.name}</h4>`;

        // Music
        if(music?.playlist?.length && settings.musicAutoplay) {
            const audio = document.getElementById('audio');
            audio.src = music.playlist[0].url;
            document.getElementById('music-btn').classList.remove('hidden');
            document.getElementById('music-btn').onclick = () => { audio.paused ? audio.play() : audio.pause(); };
        }

        // Buka Undangan
        document.getElementById('open-btn').onclick = () => {
            document.getElementById('cover').style.transform = 'translateY(-100%)';
            document.getElementById('app').style.opacity = '1';
            document.getElementById('audio').play();
            const observer = new IntersectionObserver(entries => { entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('active'); }); }, { threshold: 0.1 });
            document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
        };
    });
</script>
</body>
</html>
