<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
    <title>Karsa — Omah Aksara</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Montserrat:wght@200;300;400;500;600&family=Scheherazade+New:wght@400;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root {
            --theme-color: #5A6955;
            --bg-color: #F7F5F0;
            --text-color: #242923;
            --soft-color: #E2D9CB;
            --white-soft: #FDFDFB;
            --accent: #C49263;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        html { scroll-behavior: smooth; }
        body {
            background: #111411;
            color: var(--text-color);
            font-family: 'Montserrat', sans-serif;
            overflow-x: hidden;
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
        }
       .font-serif { font-family: 'Cormorant Garamond', serif; }
       .font-arab { font-family: 'Scheherazade New', serif; }
       
       /* Animasi Transisi Halus */
       .reveal { opacity: 0; transform: translateY(30px); transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1); }
       .reveal.active { opacity: 1; transform: translateY(0); }
       
       #cover { transition: transform 1.5s cubic-bezier(0.76, 0, 0.24, 1), opacity 1.5s; }
       .cover-gradient { background: linear-gradient(to top, rgba(17,20,17,0.95) 0%, rgba(17,20,17,0.6) 50%, rgba(0,0,0,0.2) 100%); }
       
       /* Pembungkus Frame Mobile Premium */
       .phone-wrapper {
            max-width: 425px;
            margin: 0 auto;
            background: var(--bg-color);
            box-shadow: 0 0 50px rgba(0,0,0,0.3);
            position: relative;
            min-height: 100vh;
        }
       
       /* Layout Bingkai Foto Asimetris/Editorial */
       .editorial-frame {
            position: relative;
            width: 85%;
            aspect-ratio: 3/4;
            margin: 0 auto;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.08);
            border: 1px solid rgba(0,0,0,0.02);
            background: #f0ebe1;
        }
       .editorial-frame img { width: 100%; height: 100%; object-fit: cover; transition: transform 2.5s ease; }
       .arch-mask { border-radius: 200px 200px 0 0; }
       
       /* Tombol Aksi */
       .btn-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            border: 1px solid var(--theme-color);
            color: var(--theme-color);
            padding: 12px 24px;
            font-size: 11px;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-weight: 500;
            transition: all 0.4s ease;
            background: transparent;
            border-radius: 2px;
        }
       .btn-action:hover, .btn-action:active { background: var(--theme-color); color: #fff; }

       /* Floating Musik */
       .music-disk-box {
            position: fixed;
            bottom: 25px;
            right: calc(50% - 195px);
            z-index: 90;
            cursor: pointer;
            transition: opacity 0.5s;
        }
        @media (max-width: 435px) { .music-disk-box { right: 20px; } }
       .disk-text-wrap {
            width: 48px;
            height: 48px;
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid var(--soft-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
            animation: rotateDisk 10s linear infinite;
        }
       .disk-text-wrap.paused { animation-play-state: paused; }
        @keyframes rotateDisk { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    </style>
</head>
<body>

<!-- LAYAR COVER -->
<section id="cover" class="fixed inset-0 z-[100] flex items-center justify-center overflow-hidden bg-[#111411]">
    <img id="cover-image" class="absolute inset-0 w-full h-full object-cover opacity-40 scale-105" src="" crossorigin="anonymous">
    <div class="cover-gradient absolute inset-0"></div>
    <div class="relative z-10 text-center text-white px-6 w-full max-w-sm">
        <p class="font-serif italic text-lg tracking-wide mb-2 opacity-80">The Wedding Celebration of</p>
        <h1 id="cover-names" class="font-serif text-4xl font-light mb-10 tracking-wide leading-tight"></h1>
        <div class="h-px w-10 bg-white/20 mx-auto mb-8"></div>
        <p class="uppercase tracking-[0.3em] text-[10px] mb-2 text-stone-400 font-medium">Kepada Yth. Bapak/Ibu/Saudara/i:</p>
        <h2 id="cover-guest" class="font-serif text-2xl font-light tracking-wide text-stone-200 mb-12"></h2>
        <button id="open-btn" class="border border-white/30 bg-white/5 backdrop-blur-md px-8 py-4 tracking-[0.3em] text-[10px] uppercase text-white hover:bg-white hover:text-black transition-all duration-500">
            Buka Undangan
        </button>
    </div>
</section>

<!-- APLIKASI UTAMA (MOBILE WRAPPER) -->
<main id="app" class="phone-wrapper opacity-0 pb-1">
    
    <!-- HERO SECTION -->
    <section class="relative h-[100vh] flex items-end justify-center px-6 pb-24 overflow-hidden">
        <img id="hero-image" class="absolute inset-0 w-full h-full object-cover" src="">
        <div class="absolute inset-0 bg-gradient-to-t from-[#F7F5F0] via-transparent to-black/20"></div>
        <div class="relative z-10 text-center w-full reveal">
            <p class="font-serif italic text-xl text-stone-600 mb-2">Undangan Pernikahan</p>
            <div class="h-px w-8 bg-stone-300 mx-auto mb-4"></div>
            <h2 id="hero-names" class="font-serif text-4xl font-light tracking-wide text-[var(--text-color)]"></h2>
        </div>
    </section>

    <!-- KUTIPAN/AYAT -->
    <section class="px-8 py-24 text-center reveal">
        <p id="quote-arab" class="font-arab text-2xl mb-8 text-[var(--theme-color)] leading-loose"></p>
        <p id="quote-text" class="font-serif italic text-base text-stone-700 font-light leading-relaxed"></p>
        <p id="quote-source" class="text-[10px] uppercase tracking-[0.3em] font-semibold text-stone-400 mt-6"></p>
    </section>

    <!-- MEMPELAI -->
    <section class="py-20 bg-[#F3EFE6]/50 border-y border-stone-200/30">
        <div id="groom-section" class="px-6 mb-16"></div>
        <div class="py-4 text-center reveal"><span class="font-serif font-light text-3xl italic text-stone-300">&</span></div>
        <div id="bride-section" class="px-6"></div>
    </section>

    <!-- KISAH CINTA (FOTO PER MOMEN) -->
    <section id="story-section" class="py-24 bg-white hidden">
        <p class="text-[10px] uppercase tracking-[0.4em] text-center text-stone-400 mb-2">Our Journey</p>
        <h3 class="font-serif text-center font-light text-3xl text-[var(--text-color)] mb-16 tracking-wide">Kisah Kami</h3>
        <div id="story-list" class="px-6 space-y-12"></div>
    </section>

    <!-- DETAIL ACARA & INTEGRASI TOMBOL -->
    <section id="event-section" class="py-24 px-6 border-t border-stone-200/40 hidden">
        <p class="text-[10px] uppercase tracking-[0.4em] text-center text-stone-400 mb-2">Event Detail</p>
        <h3 class="font-serif text-center font-light text-3xl text-[var(--text-color)] mb-12 tracking-wide">Waktu & Tempat</h3>
        <div id="event-list" class="space-y-6"></div>
        
        <!-- COUNTDOWN -->
        <div id="countdown-wrap" class="mt-16 pt-12 border-t border-dashed border-stone-300/60 hidden text-center">
            <p class="uppercase tracking-[0.2em] text-[10px] font-medium mb-6 text-stone-400">Menuju Hari Bahagia</p>
            <div id="countdown" class="flex justify-center gap-4"></div>
        </div>
    </section>

    <!-- DOKUMENTASI/GALERI -->
    <section id="gallery-section" class="py-24 px-4 bg-[#FBFBFA] border-t border-stone-100 hidden">
        <p class="text-[10px] uppercase tracking-[0.4em] text-center text-stone-400 mb-2">Gallery</p>
        <h3 class="font-serif text-center font-light text-3xl text-[var(--text-color)] mb-12 tracking-wide">Momen Bahagia</h3>
        <div id="gallery-grid" class="grid grid-cols-2 gap-2.5"></div>
    </section>

    <!-- WEDDING GIFT -->
    <section id="gift-section" class="py-24 px-6 bg-stone-50 border-t border-stone-100 hidden">
        <p class="text-[10px] uppercase tracking-[0.4em] text-center text-stone-400 mb-2">Love Gift</p>
        <h3 class="font-serif text-center font-light text-3xl text-[var(--text-color)] mb-12 tracking-wide">Tanda Kasih</h3>
        <div id="gift-container" class="space-y-4"></div>
    </section>

    <!-- RSVP & KONFIRMASI -->
    <section id="rsvp-section" class="py-24 px-6 bg-[var(--bg-color)]">
        <p class="text-[10px] uppercase tracking-[0.3em] text-[var(--theme-color)] mb-2 text-center">Rsvp & Wishes</p>
        <h3 class="font-serif text-3xl font-light tracking-wide mb-8 text-center">Konfirmasi Kehadiran</h3>
        <form id="wishes-form" class="space-y-4 bg-white p-6 border border-[var(--soft-color)] mb-8 shadow-sm">
            <div>
                <label class="block text-[10px] uppercase tracking-[0.2em] mb-1.5 text-stone-500">Nama Lengkap</label>
                <input type="text" id="wish-name" required class="w-full bg-transparent border-b border-stone-300 py-2 text-sm focus:outline-none focus:border-[var(--theme-color)] transition">
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-[10px] uppercase tracking-[0.2em] mb-1.5 text-stone-500">Kehadiran</label>
                    <select id="wish-status" class="w-full bg-transparent border-b border-stone-300 py-2 text-sm focus:outline-none focus:border-[var(--theme-color)] transition">
                        <option value="Hadir">Hadir</option>
                        <option value="Tidak Hadir">Tidak Hadir</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] uppercase tracking-[0.2em] mb-1.5 text-stone-500">Jumlah Pax</label>
                    <select id="wish-pax" class="w-full bg-transparent border-b border-stone-300 py-2 text-sm focus:outline-none focus:border-[var(--theme-color)] transition">
                        <option value="1">1 Orang</option><option value="2">2 Orang</option><option value="3">3 Orang</option><option value="4">4 Orang</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="block text-[10px] uppercase tracking-[0.2em] mb-1.5 text-stone-500">Ucapan / Doa Restu</label>
                <textarea id="wish-message" required rows="3" class="w-full bg-transparent border border-stone-300 p-2.5 text-sm focus:outline-none focus:border-[var(--theme-color)] transition resize-none"></textarea>
            </div>
            <button type="submit" class="w-full bg-[var(--theme-color)] text-white text-[10px] uppercase tracking-[0.3em] py-3.5 font-medium hover:bg-[var(--text-color)] transition duration-300">Kirim Konfirmasi</button>
        </form>
        
        <div class="border-t border-[var(--soft-color)] pt-6">
            <div id="wishes-box" class="space-y-3 max-h-80 overflow-y-auto pr-1"></div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="py-20 bg-[#111411] text-white text-center px-6">
        <p class="font-serif italic text-base text-stone-400 mb-4">Merupakan suatu kehormatan & kebahagiaan bagi kami,</p>
        <h2 id="footer-names" class="font-serif text-3xl font-light tracking-widest text-stone-200 mb-10"></h2>
        <div class="h-px w-6 bg-stone-700 mx-auto mb-6"></div>
        <p class="text-[9px] uppercase tracking-[0.5em] text-stone-500">Omah Aksara Digital Studio</p>
    </footer>
</main>

<!-- FLOATING MUSIC -->
<div id="music-btn" class="music-disk-box hidden">
    <div id="disk-wrap" class="disk-text-wrap">
        <svg class="w-full h-full p-1 text-[var(--text-color)] opacity-70" viewBox="0 0 100 100">
            <path id="textPath" d="M 50,50 m -37,0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" fill="none"></path>
            <text font-size="8.3" font-family="Cormorant Garamond" letter-spacing="3" fill="currentColor">
                <textPath href="#textPath"> • SENANDUNG AKSARA • GENDING RAMPAK </textPath>
            </text>
        </svg>
        <i id="music-icon-state" class="fa-solid fa-play absolute text-xs text-stone-600"></i>
    </div>
</div>
<audio id="audio" loop></audio>

<script>
    const params = new URLSearchParams(window.location.search);
    const clientSlug = params.get('c') || 'afif-sindi';
    const guestName = params.get('to')?.replace(/\+/g,' ') || 'Tamu Undangan';
    const basePath = `../../public/clients/${clientSlug}/`;
    const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwzbrMzVWSHCF9u8I1FbY4h4i_GoxL6kvTbFxFrcZ-VG9_qun2wK0c4mIupBKiGk1Yvmw/exec';

    fetch(`${basePath}data.json`, { cache: 'no-store' })
   .then(res => {
        if(!res.ok) throw new Error("Gagal memuat konfigurasi data.");
        return res.json();
    })
   .then(data => {
        const { couple, settings, events, gallery, loveStory, quote, music, digitalGift } = data;
        const pairNick = `${couple.groom.nickname} & ${couple.bride.nickname}`;
        
        if(settings?.themeColor) document.documentElement.style.setProperty('--theme-color', settings.themeColor);
        if(settings?.bgColor) document.documentElement.style.setProperty('--bg-color', settings.bgColor);
        
        document.getElementById('cover-names').innerText = pairNick;
        document.getElementById('hero-names').innerText = pairNick;
        document.getElementById('footer-names').innerText = pairNick;
        document.getElementById('cover-guest').innerText = guestName;
        document.getElementById('hero-image').src = basePath + gallery.heroImage;
        document.getElementById('cover-image').src = basePath + gallery.heroImage;

        if(quote?.text) {
            document.getElementById('quote-arab').textContent = quote.arab || '';
            document.getElementById('quote-text').innerHTML = `“ ${quote.text} ”`;
            document.getElementById('quote-source').textContent = quote.source || '';
        }

        // Render Mempelai (Tampilan Asimetris Premium)
        document.getElementById('groom-section').innerHTML = `
            <div class="editorial-frame arch-mask reveal"><img src="${basePath + couple.groom.image}"></div>
            <div class="mt-6 text-left pl-6 reveal">
                <p class="uppercase tracking-[0.3em] text-[10px] mb-2 text-stone-400 font-medium">Mempelai Pria</p>
                <h4 class="font-serif text-3xl font-light text-[var(--text-color)] mb-1">${couple.groom.name}</h4>
                <p class="text-xs text-stone-500 font-light italic">Putra dari Bapak ${couple.groom.father} & Ibu ${couple.groom.mother}</p>
                ${couple.groom.instagram ? `<a href="https://instagram.com/${couple.groom.instagram.replace('@','')}" target="_blank" class="inline-flex items-center gap-1 mt-3 text-[10px] tracking-wider uppercase font-medium text-stone-600"><i class="fa-brands fa-instagram"></i> ${couple.groom.instagram}</a>` : ''}
            </div>`;

        document.getElementById('bride-section').innerHTML = `
            <div class="editorial-frame arch-mask reveal"><img src="${basePath + couple.bride.image}"></div>
            <div class="mt-6 text-right pr-6 reveal">
                <p class="uppercase tracking-[0.3em] text-[10px] mb-2 text-stone-400 font-medium">Mempelai Wanita</p>
                <h4 class="font-serif text-3xl font-light text-[var(--text-color)] mb-1">${couple.bride.name}</h4>
                <p class="text-xs text-stone-500 font-light italic">Putri dari Bapak ${couple.bride.father} & Ibu ${couple.bride.mother}</p>
                ${couple.bride.instagram ? `<a href="https://instagram.com/${couple.bride.instagram.replace('@','')}" target="_blank" class="inline-flex items-center gap-1 mt-3 text-[10px] tracking-wider uppercase font-medium text-stone-600">${couple.bride.instagram} <i class="fa-brands fa-instagram"></i></a>` : ''}
            </div>`;

        // Render Kisah Cinta Berbasis Foto Per Momen (Sesuai Struktur data.json)
        if(loveStory?.length && settings.showLoveStory) {
            document.getElementById('story-section').classList.remove('hidden');
            const storyList = document.getElementById('story-list');
            storyList.innerHTML = '';
            loveStory.forEach(ls => {
                storyList.innerHTML += `
                    <div class="bg-stone-50/60 p-4 border border-stone-200/40 rounded-sm reveal space-y-3">
                        ${ls.image ? `<div class="overflow-hidden rounded-sm shadow-sm"><img src="${basePath + ls.image}" class="w-full object-cover aspect-[4/3] transform hover:scale-105 transition duration-700" loading="lazy"></div>` : ''}
                        <div>
                            <span class="text-[10px] font-mono tracking-widest text-[var(--accent)] font-semibold">${ls.date || ls.year}</span>
                            <h6 class="font-serif text-xl font-light text-stone-800 mt-0.5 mb-1.5">${ls.title}</h6>
                            <p class="text-xs text-stone-500 font-light leading-relaxed whitespace-pre-line">${ls.description}</p>
                        </div>
                    </div>`;
            });
        }

        // Render Acara + Tombol Langsung Terintegrasi (Maps & Google Calendar)
        if(events?.length) {
            document.getElementById('event-section').classList.remove('hidden');
            const eventList = document.getElementById('event-list');
            eventList.innerHTML = '';
            events.forEach(ev => {
                const eventDate = new Date(ev.date);
                const dateString = eventDate.toLocaleDateString('id-ID', {weekday:'long', day:'numeric', month:'long', year:'numeric'});
                
                // Pembentukan Link Google Calendar Dinamis
                const gCalDate = eventDate.toISOString().replace(/-|:|\.\d\d\d/g,"");
                const gCalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(ev.title)}&dates=${gCalDate}/${gCalDate}&details=${encodeURIComponent(ev.address)}&location=${encodeURIComponent(ev.googleMaps)}`;

                eventList.innerHTML += `
                    <div class="bg-white border border-stone-200/60 p-6 text-center shadow-sm reveal space-y-4">
                        <h5 class="font-serif text-2xl font-light text-[var(--text-color)] tracking-wide">${ev.title}</h5>
                        <div class="text-xs font-light text-stone-500 space-y-1">
                            <p class="font-medium text-[var(--accent)] uppercase tracking-wider">${dateString}</p>
                            <p class="font-mono text-[11px]">${ev.startTime} — ${ev.endTime} ${ev.timezone || ''}</p>
                            <p class="pt-2 font-serif text-sm text-stone-600 italic px-2">${ev.address}</p>
                        </div>
                        <div class="grid grid-cols-2 gap-2 pt-2">
                            <a href="${ev.googleMaps}" target="_blank" class="btn-action"><i class="fa-solid fa-map-location-dot"></i> Google Maps</a>
                            <a href="${gCalUrl}" target="_blank" class="btn-action"><i class="fa-regular fa-calendar-plus"></i> Catat Agenda</a>
                        </div>
                    </div>`;
            });

            // Countdown Timer
            if(settings.showCountdown) {
                const tzMap = { WITA: '+08:00', WIB: '+07:00', WIT: '+09:00' };
                const tz = tzMap[events[0].timezone] || '+08:00';
                const targetTime = new Date(`${events[0].date}T${events[0].startTime}:00${tz}`).getTime();
                setInterval(() => {
                    const diff = targetTime - new Date().getTime();
                    const d = Math.max(0, Math.floor(diff / (1000*60*60*24)));
                    const h = Math.max(0, Math.floor((diff % (1000*60*60*24)) / (1000*60*60)));
                    const m = Math.max(0, Math.floor((diff % (1000*60*60)) / (1000*60)));
                    const s = Math.max(0, Math.floor((diff % (1000*60)) / 1000));
                    document.getElementById('countdown').innerHTML = `
                        ${[['Hari', d], ['Jam', h], ['Menit', m], ['Detik', s]].map(t => `
                            <div class="bg-white/60 border border-stone-200/50 rounded p-2 min-w-[65px]">
                                <span class="block font-serif text-2xl font-light text-stone-700">${t[1]}</span>
                                <span class="text-[9px] text-stone-400 uppercase tracking-widest block mt-0.5">${t[0]}</span>
                            </div>
                        `).join('')}`;
                }, 1000);
                document.getElementById('countdown-wrap').classList.remove('hidden');
            }
        }

        // Render Galeri
        if(gallery?.album?.length && settings.showGallery) {
            document.getElementById('gallery-section').classList.remove('hidden');
            const grid = document.getElementById('gallery-grid');
            grid.innerHTML = '';
            gallery.album.forEach(img => {
                grid.innerHTML += `<div class="overflow-hidden shadow-sm aspect-square bg-stone-100"><img src="${basePath + img}" class="reveal w-full h-full object-cover" loading="lazy"></div>`;
            });
        }

        // Render Gift & Integrasi WhatsApp Konfirmasi Hadiah
        if(digitalGift?.accounts?.length && settings.showGift) {
            document.getElementById('gift-section').classList.remove('hidden');
            const giftContainer = document.getElementById('gift-container');
            giftContainer.innerHTML = '';
            digitalGift.accounts.forEach((bank, i) => {
                const waGiftUrl = `https://api.whatsapp.com/send?phone=${encodeURIComponent(digitalGift.waConfirmation || '')}&text=${encodeURIComponent(`Halo ${pairNick}, saya ingin konfirmasi pengiriman tanda kasih berupa digital gift.`)}`;
                
                giftContainer.innerHTML += `
                    <div class="p-5 bg-white border border-stone-200 text-center reveal space-y-2 shadow-sm">
                        <p class="text-[10px] uppercase tracking-wider text-stone-400 font-medium">${bank.provider}</p>
                        <p class="font-mono text-base text-stone-800 font-semibold tracking-wide" id="rek-${i}">${bank.accountNumber}</p>
                        <p class="text-xs text-stone-500 italic">a.n ${bank.accountHolder}</p>
                        <div class="grid grid-cols-2 gap-2 pt-3">
                            <button onclick="copyRek('rek-${i}')" class="btn-action !py-2"><i class="fa-regular fa-copy"></i> Salin</button>
                            <a href="${waGiftUrl}" target="_blank" class="btn-action !py-2"><i class="fa-brands fa-whatsapp"></i> Konfirmasi</a>
                        </div>
                    </div>`;
            });
        }

        // Kontrol Musik Otomatis
        if(music?.playlist?.length && settings.musicAutoplay) {
            const defaultSong = music.playlist.find(song => song.isDefault) || music.playlist[0];
            const audio = document.getElementById('audio');
            const diskWrap = document.getElementById('disk-wrap');
            const stateIcon = document.getElementById('music-icon-state');
            audio.src = defaultSong.url;
            const musicBtn = document.getElementById('music-btn');
            musicBtn.classList.remove('hidden');
            
            musicBtn.onclick = () => {
                if(audio.paused) {
                    audio.play();
                    diskWrap.classList.remove('paused');
                    stateIcon.className = "fa-solid fa-pause absolute text-xs text-stone-600";
                } else {
                    audio.pause();
                    diskWrap.classList.add('paused');
                    stateIcon.className = "fa-solid fa-play absolute text-xs text-stone-600";
                }
            };
        }

        // Pemanggilan Data Ucapan
        function loadGoogleSheetsWishes() {
            const wishesBox = document.getElementById('wishes-box');
            wishesBox.innerHTML = `<p class="text-[11px] text-stone-400 text-center py-4 italic animate-pulse">Menyelaraskan doa...</p>`;
            const callbackName = 'jsonp_callback_' + Math.round(100000 * Math.random());
            window[callbackName] = function(wishes) {
                delete window[callbackName];
                document.body.removeChild(script);
                wishesBox.innerHTML = '';
                if (!wishes || wishes.length === 0) {
                    wishesBox.innerHTML = `<p class="text-[11px] text-stone-400 text-center py-4 italic">Belum ada ucapan tertulis.</p>`;
                    return;
                }
                wishes.forEach(wish => {
                    const badge = wish.kehadiran === 'Hadir' ? 'bg-stone-800 text-white' : 'bg-stone-200 text-stone-600';
                    wishesBox.innerHTML += `
                        <div class="p-3.5 bg-white border border-stone-200 text-left space-y-1.5 shadow-sm">
                            <div class="flex items-center justify-between">
                                <p class="text-xs font-semibold text-stone-800">${wish.nama}</p>
                                <span class="text-[9px] px-1.5 py-0.5 font-mono uppercase font-medium ${badge}">${wish.kehadiran}</span>
                            </div>
                            <p class="text-xs text-stone-600 font-light leading-relaxed whitespace-pre-line">${wish.ucapan}</p>
                        </div>`;
                });
            };
            const script = document.createElement('script');
            script.src = `${SCRIPT_URL}?id_klien=${encodeURIComponent(clientSlug)}&callback=${callbackName}`;
            document.body.appendChild(script);
        }

        // Form Submit RSVP
        document.getElementById('wishes-form').addEventListener('submit', function(e){
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            btn.innerHTML = 'Mengirim...';
            btn.disabled = true;
            const payload = {
                id_klien: clientSlug,
                nama: document.getElementById('wish-name').value,
                ucapan: document.getElementById('wish-message').value,
                kehadiran: document.getElementById('wish-status').value,
                jumlah_tamu: parseInt(document.getElementById('wish-pax').value)
            };
            fetch(SCRIPT_URL, { method: 'POST', mode: 'no-cors', body: JSON.stringify(payload) })
           .then(() => {
                document.getElementById('wishes-form').reset();
                btn.innerHTML = 'Terkirim ✓';
                setTimeout(() => { btn.innerHTML = 'Kirim Konfirmasi'; btn.disabled = false; }, 2000);
                setTimeout(loadGoogleSheetsWishes, 1000);
            });
        });

        loadGoogleSheetsWishes();

        // Trigger Buka Undangan
        document.getElementById('open-btn').onclick = () => {
            document.getElementById('cover').style.transform = 'translateY(-100%)';
            document.getElementById('app').style.opacity = '1';
            if(settings.musicAutoplay && music?.playlist?.length) {
                document.getElementById('audio').play().catch(() => {});
            }
            const observer = new IntersectionObserver(entries => {
                entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('active'); });
            }, { threshold: 0.05 });
            document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
        };
    })
   .catch(err => {
        document.body.innerHTML = `<div class="p-8 text-center bg-white h-screen flex flex-col justify-center items-center font-sans"><h1 class="text-lg font-bold text-red-600">Error Konfigurasi</h1><p class="text-xs text-stone-500 mt-1">${err.message}</p></div>`;
   });

    function copyRek(id) {
        const text = document.getElementById(id).innerText;
        navigator.clipboard.writeText(text).then(() => {
            alert('Nomor rekening disalin: ' + text);
        });
    }
</script>
</body>
</html>
