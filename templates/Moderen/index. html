<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Karsa — Omah Aksara</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Montserrat:wght@300;400;500&family=Scheherazade+New:wght@400;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root { --theme-color: #1A1A1A; --bg-color: #FAFAFA; --text-color: #2D2D2D; --soft-color: #E5E5E5; --white-soft: #FFFFFF; }
        body { background: #121212; color: var(--text-color); font-family: 'Montserrat', sans-serif; }
       .font-serif { font-family: 'Cormorant Garamond', serif; }
       .font-arab { font-family: 'Scheherazade New', serif; }
       .reveal { opacity: 0; transform: translateY(20px); transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1); }
       .reveal.active { opacity: 1; transform: translateY(0); }
       .phone-wrapper { max-width: 425px; margin: 0 auto; background: var(--bg-color); position: relative; min-height: 100vh; }
       .modern-frame { width: 100%; aspect-ratio: 4/5; overflow: hidden; background: #F5F5F5; border: 1px solid var(--soft-color); }
       .modern-frame img { width: 100%; height: 100%; object-fit: cover; }
        #cover { transition: transform 1.2s cubic-bezier(0.76, 0, 0.24, 1); }
    </style>
</head>
<body>
<!-- COVER - ID WAJIB ADA -->
<section id="cover" class="fixed inset-0 z-[100] flex items-center justify-center bg-[#121212]">
    <img id="cover-image" class="absolute inset-0 w-full h-full object-cover opacity-30" src="">
    <div class="relative z-10 text-center text-white px-8">
        <h1 id="cover-names" class="font-serif text-4xl mb-8"></h1>
        <p id="cover-guest" class="font-serif text-2xl mb-10"></p>
        <button id="open-btn" class="border border-white/40 px-8 py-4 text- uppercase tracking-[0.3em]">Buka Undangan</button>
    </div>
</section>

<main id="app" class="phone-wrapper opacity-0">
    <section class="relative h-"><img id="hero-image" class="absolute inset-0 w-full h-full object-cover" src=""><div class="absolute inset-0 bg-gradient-to-t from-white to-transparent"></div><div class="absolute bottom-20 w-full text-center"><h2 id="hero-names" class="font-serif text-4xl"></h2></div></section>
    <section class="px-8 py-16 text-center"><p id="quote-arab" class="font-arab text-2xl mb-4"></p><p id="quote-text" class="font-serif italic"></p><p id="quote-source" class="text- mt-4 uppercase tracking-widest"></p></section>
    <section class="py-16 px-6 space-y-10"><div id="groom-section"></div><div id="bride-section"></div></section>
    <section id="story-section" class="py-16 px-6 hidden"><h3 class="font-serif text-center text-3xl mb-10">Kisah Kami</h3><div id="story-list" class="space-y-8"></div></section>
    <section id="event-section" class="py-16 px-6 hidden"><h3 class="font-serif text-center text-3xl mb-10">Waktu & Tempat</h3><div id="event-list" class="space-y-8"></div><div id="countdown-wrap" class="hidden mt-10"><div id="countdown" class="flex justify-center gap-2"></div></div></section>
    <section id="gallery-section" class="py-16 px-6 hidden"><div id="gallery-grid" class="grid grid-cols-2 gap-3"></div></section>
    <section id="gift-section" class="py-16 px-6 hidden"><div id="gift-container"></div></section>
    <section id="rsvp-section" class="py-16 px-6"><form id="wishes-form" class="space-y-4"><input id="wish-name" required placeholder="Nama" class="w-full border-b py-2 text-sm"><div class="grid grid-cols-2 gap-4"><select id="wish-status" class="border-b py-2 text-sm"><option>Hadir</option><option>Tidak Hadir</option></select><select id="wish-pax" class="border-b py-2 text-sm"><option value="1">1 Orang</option><option value="2">2 Orang</option></select></div><textarea id="wish-message" required placeholder="Ucapan" class="w-full border p-2 text-sm"></textarea><button type="submit" class="w-full bg-black text-white py-4 text- uppercase tracking-widest">Kirim</button></form><div id="wishes-box" class="mt-8 space-y-3 max-h-80 overflow-y-auto"></div></section>
    <footer class="py-16 bg-black text-white text-center"><h2 id="footer-names" class="font-serif text-2xl"></h2></footer>
</main>

<script>
    const params = new URLSearchParams(window.location.search);
    const clientSlug = params.get('c') || 'afif-sindi';
    const guestName = params.get('to')?.replace(/\+/g,' ') || 'Tamu Undangan';
    
    // INI KUNCI ANTI BLANK
    const isSubFolder = window.location.pathname.includes('/templates/');
    const basePath = isSubFolder ? `../../public/clients/${clientSlug}/` : `public/clients/${clientSlug}/`;
    
    let SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwzbrMzVWSHCF9u8I1FbY4h4i_GoxL6kvTbFxFrcZ-VG9_qun2wK0c4mIupBKiGk1Yvmw/exec";

    fetch(`${basePath}data.json`, { cache: 'no-store' })
   .then(res => {
        if(!res.ok) throw new Error(`data.json tidak ketemu di ${basePath}data.json`);
        return res.json();
    })
   .then(data => {
        const { couple, settings, events, gallery, loveStory, quote, music, digitalGift, link } = data;
        const pairNick = `${couple.groom.nickname} & ${couple.bride.nickname}`;
        if(link?.apiUcapan) SCRIPT_URL = link.apiUcapan;
        if(settings?.themeColor) document.documentElement.style.setProperty('--theme-color', settings.themeColor);

        // ID INI WAJIB ADA, JANGAN DIHAPUS
        document.getElementById('cover-names').innerText = pairNick;
        document.getElementById('hero-names').innerText = pairNick;
        document.getElementById('footer-names').innerText = pairNick;
        document.getElementById('cover-guest').innerText = guestName;
        document.getElementById('cover-image').src = basePath + gallery.heroImage;
        document.getElementById('hero-image').src = basePath + gallery.heroImage;
        if(quote?.text){
            document.getElementById('quote-arab').innerText = quote.arab || '';
            document.getElementById('quote-text').innerText = quote.text;
            document.getElementById('quote-source').innerText = quote.source || '';
        }
        document.getElementById('groom-section').innerHTML = `<div class="modern-frame"><img src="${basePath+couple.groom.image}"></div><h4 class="font-serif text-2xl mt-4">${couple.groom.name}</h4><p class="text-xs">Putra dari ${couple.groom.father} & ${couple.groom.mother}</p>`;
        document.getElementById('bride-section').innerHTML = `<div class="modern-frame"><img src="${basePath+couple.bride.image}"></div><h4 class="font-serif text-2xl mt-4">${couple.bride.name}</h4><p class="text-xs">Putri dari ${couple.bride.father} & ${couple.bride.mother}</p>`;

        // EVENT, GALLERY, GIFT, DLL LOGIC SAMA PERSIS KAYAK SCRIPT LAMAMU
        if(events?.length){ document.getElementById('event-section').classList.remove('hidden'); document.getElementById('event-list').innerHTML = events.map(ev => `<div><h5 class="font-serif text-xl">${ev.title}</h5><p class="text-xs">${ev.date} ${ev.startTime}</p><p class="text-xs">${ev.address}</p><a href="${ev.googleMaps}" target="_blank" class="text- underline">Buka Maps</a></div>`).join(''); }
        if(loveStory?.length && settings.showLoveStory){ document.getElementById('story-section').classList.remove('hidden'); document.getElementById('story-list').innerHTML = loveStory.map(ls => `<div><p class="text-">${ls.date}</p><h6 class="font-serif">${ls.title}</h6><p class="text-xs">${ls.description}</p></div>`).join(''); }
        if(gallery?.album?.length && settings.showGallery){ document.getElementById('gallery-section').classList.remove('hidden'); document.getElementById('gallery-grid').innerHTML = gallery.album.map(img => `<img src="${basePath+img}" class="w-full">`).join(''); }
        if(digitalGift?.accounts?.length && settings.showGift){ document.getElementById('gift-section').classList.remove('hidden'); document.getElementById('gift-container').innerHTML = digitalGift.accounts.map((b,i) => `<div class="border p-4"><p>${b.provider}</p><p id="rek-${i}">${b.accountNumber}</p><p class="text-xs">a.n ${b.accountHolder}</p></div>`).join(''); }

        document.getElementById('open-btn').onclick = () => {
            document.getElementById('cover').style.transform = 'translateY(-100%)';
            document.getElementById('app').style.opacity = '1';
        };
    })
   .catch(err => {
        console.error(err);
        document.body.innerHTML = `<div style="padding:40px;text-align:center"><h1>Error: ${err.message}</h1><p>Slug: ${clientSlug}</p><p>Cek folder public/clients/${clientSlug}/data.json ada atau tidak</p></div>`;
    });

    // RSVP & ucapan logic kamu tetap jalan
    document.getElementById('wishes-form')?.addEventListener('submit', function(e){
        e.preventDefault();
        const payload = { id_klien: clientSlug, nama: document.getElementById('wish-name').value, ucapan: document.getElementById('wish-message').value, kehadiran: document.getElementById('wish-status').value, jumlah_tamu: parseInt(document.getElementById('wish-pax').value) };
        fetch(SCRIPT_URL, { method: 'POST', mode: 'no-cors', body: JSON.stringify(payload) }).then(()=>{ alert('Terkirim'); e.target.reset(); });
    });
</script>
</body>
</html>
