async function loadClientData() {
    try {
        const res = await fetch(DATA_URL);
        const data = await res.json();
        
        // Set nama couple
        const coupleName = `${data.couple.groom.nickname} & ${data.couple.bride.nickname}`;
        document.getElementById('couple-name').textContent = coupleName;
        document.getElementById('couple-footer').textContent = coupleName;
        document.title = `Wedding of ${coupleName}`;

        // Load musik - pilih yang isDefault: true
        const music = document.getElementById('bg-music');
        const musicBtn = document.getElementById('music-btn');
        if (data.music && data.music.playlist.length > 0) {
            const defaultSong = data.music.playlist.find(song => song.isDefault) || data.music.playlist[0];
            music.src = defaultSong.url;
            console.log('Now playing:', defaultSong.name); // Buat cek di console
            
            musicBtn.onclick = () => {
                if (music.paused) {
                    music.play();
                    musicBtn.classList.add('playing');
                } else {
                    music.pause();
                    musicBtn.classList.remove('playing');
                }
            };
            
            if (data.music.autoplay) {
                document.body.addEventListener('click', () => music.play().catch(e=>{}), { once: true });
            }
        } else {
            musicBtn.style.display = 'none';
        }

        // Load bank dari data.json
        const giftContainer = document.getElementById('gift-container');
        if (data.digitalGift && data.digitalGift.accounts.length > 0) {
            data.digitalGift.accounts.forEach((bank, i) => {
                giftContainer.innerHTML += `
                    <div class="p-4 bg-white border border-stone-200 rounded text-center">
                        <p class="text-xs text-stone-500">${bank.provider}</p>
                        <p class="font-luxury text-lg text-stone-800 my-1" id="rek-${i}">${bank.accountNumber}</p>
                        <p class="text-xs text-stone-600 mb-3">a.n ${bank.accountHolder}</p>
                        <button onclick="copyRek('rek-${i}')" class="text-xs bg-[#6b0505] text-white px-4 py-2 rounded uppercase tracking-wider">
                            <i class="fa-regular fa-copy mr-1"></i> Salin No. Rekening
                        </button>
                    </div>`;
            });
        }
    } catch (err) {
        console.log('Gagal load data.json', err);
    }
}
