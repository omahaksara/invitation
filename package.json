{
  "name": "omah-aksara-invitation",
  "version": "2.0.0",
  "private": true,
  "description": "Mesin undangan digital Omah Aksara",
  "scripts": {
    "check:syntax": "node --check core/app.js && cp backend/Code.gs /tmp/omah-aksara-backend.js && node --check /tmp/omah-aksara-backend.js",
    "validate:data": "node scripts/validate-invitations.cjs",
    "test:static": "npm run check:syntax && npm run validate:data",
    "test:browser": "node scripts/smoke-templates.cjs",
    "test": "npm run test:static && npm run test:backend && npm run test:browser",
    "test:backend": "node scripts/test-backend.cjs"
  },
  "engines": {
    "node": ">=20"
  }
}
